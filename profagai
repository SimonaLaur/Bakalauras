    input="$dir/phage_regions.fna"
    tmp="$dir/phage_regions.tmp"

    if [ -f "$input" ]; then
        awk '/^>/ {keep = ($0 !~ /plasmid/)} keep' "$input" > "$tmp" && mv "$tmp" "$input"
    else
        echo "File not found: $input"
    fi
done

#remoing from json file
for dir in $(grep 'plasmid' */detail.txt | grep 'region' | cut -d':' -f1 | sed 's|/detail.txt||' | sort | uniq); do
    json_file="$dir/predicted_phage_regions.json"

    if [ -f "$json_file" ]; then
        jq '[.[] | select(.contig_tag | contains("plasmid") | not)]' "$json_file" > "$json_file.tmp" && mv "$json_file.tmp" "$json_file"
    else
        echo "File not found: $json_file"
    fi
done

for dir in $(grep 'plasmid' */detail.txt \
               | cut -d: -f1 \
               | sed 's|/detail.txt||' \
               | sort -u); do

  infile="$dir/detail.txt"
  tmpfile="$dir/detail.tmp"

  awk '
    # if this is a “region” header with “plasmid” → start skipping
    /^#### region [0-9]+,.*plasmid.*####/ { skip=1; next }

    # if we are skipping, and see the next region header or “Bacterial” marker → stop skipping,
    # but don’t re‑skip this line (so it gets printed)
    skip && (/^#### region [0-9]+,/ || /^#### Bacterial ####/) { skip=0 }
    
    # if not skipping, print the line
    !skip { print }
  ' "$infile" > "$tmpfile" \
    && mv "$tmpfile" "$infile"
done

for dir in $(grep -l 'plasmid' */detail.txt \
               | sed 's|/detail.txt||' \
               | sort -u); do

  awk '
    # if this is a non‑indented line containing plasmid → start skipping
    /^[^ \t]/ && /plasmid/ { skip=1; next }
    # if skipping and line is indented → skip it
    skip && /^[ \t]/  { next }
    # if skipping and line is not indented → stop skipping
    skip && /^[^ \t]/ { skip=0 }
    # print everything when not skipping
    !skip { print }
  ' "$dir/detail.txt" > "$dir/detail.tmp" \
    && mv "$dir/detail.tmp" "$dir/detail.txt"
done


