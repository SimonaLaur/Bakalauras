#!/bin/bash

#!/bin/bash

# Global output file
global_output="all_matched_intact_phages.fasta"

# Clear the global output file before starting
> "$global_output"

# Ensure the output directory exists
mkdir -p intact_phages

# Loop through all genome folders
for dir in Failai/*/; do
    # Extract the folder name and genome ID
    folder_name=$(basename "$dir")
    genome_id=$(echo "$folder_name" | cut -d'_' -f1,2)
    
    # Define paths to JSON and FASTA files
    json_file="${dir}predicted_phage_regions.json"
    fasta_file="${dir}phage_regions.fna"
    output_file="intact_phages/${genome_id}_intact_phages.fasta"

    # Skip folder if files are missing
    if [[ ! -f "$json_file" || ! -f "$fasta_file" ]]; then
        echo "Skipping $dir (missing file)"
        continue
    fi

    # Process the directory
    echo "Processing $dir..."
    
    # Clear per-genome output file
    > "$output_file"

    # Extract intact phage regions from the JSON file
    jq -c '.[] | select(.completeness == "intact")' "$json_file" | while read -r region; do
        region_num=$(echo "$region" | jq -r '.region')
        start=$(echo "$region" | jq -r '.start')

        # Debugging: Log the region and start we're searching for
        echo "Looking for region $region_num, start $start in $fasta_file" >> debug.log

        # Find the corresponding header line in the fasta file
        header_line=$(grep -E "^>${region_num}[[:space:]:-]+${start}" "$fasta_file")

        # If header line found, extract the sequence
        if [[ -n "$header_line" ]]; then
            # Extract the sequence for the given region
            awk -v header="$header_line" -v rid="$region_num" -v gid="$genome_id" '
                BEGIN {found=0}
                $0 == header {found=1; print ">phage_"rid"_"gid; next}
                /^>/ && found {exit}
                found {print}
            ' "$fasta_file" >> "$output_file"

            # Append the same sequence to the global output file
            awk -v header="$header_line" -v rid="$region_num" -v gid="$genome_id" '
                BEGIN {found=0}
                $0 == header {found=1; print ">phage_"rid"_"gid; next}
                /^>/ && found {exit}
                found {print}
            ' "$fasta_file" >> "$global_output"
        else
            # Log header not found
            echo "Header not found for region: $region_num, start: $start in $fasta_file" >> error.log
        fi
    done

    # Indicate that the folder is processed
    echo "Finished $dir >> $output_file"
done

# Final message after processing all genomes
echo "All genomes processed. Combined intact phage sequences saved to: $global_output"



