global_output="all_matched_intact_phages.fasta"
> "$global_output"  # Clear old global output before starting

for dir in Failai/*/; do
    folder_name=$(basename "$dir")
    genome_id=$(echo "$folder_name" | cut -d'_' -f1,2)
    json_file="$dir/predicted_phage_regions.json"
    fasta_file="${dir}phage_regions.fna"
    output_file="intact_phages/${genome_id}_intact_phages.fasta"

    # Check if required files exist
    if [[ ! -f "$json_file" || ! -f "$fasta_file" ]]; then
        echo "Skipping $dir (missing file)"
        continue
    fi
    echo "Processing $dir..."
    > "$output_file"

    jq -c '.[] | select(.completeness=="intact")' "$json_file" | while read -r region; do
        region_num=$(echo "$region" | jq -r '.region')
        start=$(echo "$region" | jq -r '.start')  # (note: 'start' is parsed but not used later)

        # Find matching header
        header_line=$(grep "^>[^[:space:]]" "$fasta_file" | grep ">${region_num}" | head -n 1)

        if [[ -n "$header_line" ]]; then
            awk -v header="$header_line" -v rid="$region_num" -v gid="$genome_id" '
                BEGIN {found=0}
                $0 == header {found=1; print ">phage_"rid"_"gid; next}
                /^>/ && found {exit}
                found {print}
            ' "$fasta_file" | tee -a "$output_file" >> "$global_output"
        fi
    done

