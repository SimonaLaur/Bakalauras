## Tarpai lotyniškame pavadinime pakeičiami, kad būtų lengviau įsikelti į R

awk 'BEGIN {OFS="\t"} {organism = substr($0, index($0,$3)); gsub(/ /, "_", organism); print $1" "$2, organism}' IDs_pavadinimai.txt > sutvarkytas.txt


 awk 'BEGIN {OFS="\t"} {organism = substr($0, index($0,$3)); gsub(/ /, " ", organism); print $1" "$2, organism}' IDs_pavadinimai.txt > sutvarkytas.txt
###########################################

##### Pavadinimų keitimui jalview #############


grep ">" sekos.fasta | awk '{print $1}' | tr -d ">"  | sort | uniq > IDs.txt


### Pilnas_pavadinimas.txt -- organizmų pavadinimai paiimti iš sekos.fasta failo

cat IDs.txt Pilnas_pavadinimas.txt | sort | uniq -c | sort -r -nk 1 


### Tekstiniai duomenys modifikuojami, kad būtų lengviau nuskaitomi R + pašalinama nereikalinga informacija

awk '{
    split($0, fields, ",")
    printf "%s\t%s\n", $1, fields[1]
}' Pilnas_pavadinimas.txt | sed 's/>//g' | sort -k1 | head >> nauji.txt


########################## Lentele su pavadinimais ########################
# Išfltruojamas rūšies pavadinimas

grep '>' sekos.fasta | awk '{print $2" "$3" "$4" "$5}'| sed 's/strain.*//g' |tr -d ">" | sort >> seku_pavadinima.txt

# Suskaičiuojama kiek yra skirtingų rūšių organizmų
awk '{print $3}' sutvarkytas.txt sed 's/piscium_.*/piscium/' | sed 's/_CIRM-BIA[0-9]*//g' | sed 's/_Lg[0-9]*//g' | sed 's/_ATCC_[0-9]*//g' | sed 's/_sp.*/_sp./g' |  sed 's/subsp._cremoris.*/subsp._cremoris/' | sed 's/subsp._lactis.*/subsp._lactis/' | sort |  sed 's/^[[:space:]]*//;s/[[:space:]]*$//'  | uniq -c

