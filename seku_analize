#Šitas failas skirtas sekų atsirinkimui ir paligynių sudarymui

#Iš NCBI atsisiunčiami RefSeq ir GenBank anotacijos, kurios perkeliamos į atskirus failus
for directory in GCA*; do
  sample=$(basename $directory);
    mv -n "$sample" ../../input/GenBank/
done
#######################################
# GenBank failo anotacijos fna formatu turi ne tik genomo sekas, bet ir plazmidžių
# Komandinė eilutė nauodjama atrinkti genomo sekoms ir sudėti jas į atskirą failą

grep '>' *.fna
find . -type f -name "*.fna" -exec grep 'genome' {} \; | wc -l

for file in $(find . -type f -name "*.fna"); do
    awk '/genome/{if (seq) print seq; print; seq=""} !/^>/{seq=seq $0} END {if (seq) print seq}' "$file" >> sekos.fasta
done 
### Surenkamos visos sekos, kuriios savo pavadinime turi 'genome', tačiau kartu paimamos ir plazmidės. Todėl reikia papildomo žingsnio siekiant pšalinti plazmidžių sekas.

######################### Seku fragmentai ###################
awk 'BEGIN {IGNORECASE=1} 
     FNR==1 {keep=1} 
     /^>/ {keep = ($0 !~ /plasmid/)} 
     keep' GenBank/*/*.fna >> sekos.fasta

### Atrenkamos genomo sekos

########### sRNR/ dif/ XerS pradžios Blast ##############

efetch -db nucleotide -id "NC_009004.1" -seq_start 1237897 -seq_stop 1238533 -format fasta > referentine.fasta
# regionas paiimtas remiantis straipsnio informacija ir Mildos darbais

blastn -query referentine.fasta -subject sekos.fasta -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore sstrand" > blast_motyvas.txt

awk '{print $2, $9, $10, "0", "0", $13 }' blast_motyvas.txt | sed -e 's/plus/+/g' -e 's/minus/-/g' | 
awk 'OFS="\t" { if ($2 > $3) { t = $2; $2 = $3; $3 = t; } print }' | sed 's/ /\t/g' > motyvo_koordinates.bed

#Kadangi pažiūrėjus fasta failus buvo rasta, jog kai kurios sekos turi neaiškius fragmentus ties sRNR, šie fragmentai buvo prailginti ir patikrintus prailgintų sekų panašumas.

bedtools slop -i motyvo_koordinates.bed  -g sekos.fasta.fai -l 100 -r 0  -s > prailginta.bed


bedtools getfasta -fi sekos.fasta -bed prailginta.bed -s -fo prailginta.fasta

############################################

### Atskirų fragmentų panašumo patikrinimas, siekiant pažiūrėti ar sekose, kur rastas motyvo atitikmuo tie fragmentai yra aptinkami ar ne.

### Šis žngsnis nebūtinas, labiau siekiant daryti išvadas apie konservatyvių fragmentų evoliucinį egzistavimą


#################### Dif #############################


makeblastdb -in sekos.fasta -dbtype nucl -parse_seqids && \
blastn -query dif.fasta -subject sekos.fasta -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore sstrand" | \
awk '{print $2, $9, $10, "0", "0", $13 }' | \
sed -e 's/plus/+/g' -e 's/minus/-/g' | \
awk 'OFS="\t" { if ($2 > $3) { t = $2; $2 = $3; $3 = t; } print }' | \
sed 's/ /\t/g' | \
bedtools getfasta -fi sekos.fasta -bed stdin -s -fo dif_seka.fasta


